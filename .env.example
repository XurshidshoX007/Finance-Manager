# ============================================
# Finance Manager - Environment Configuration
# ============================================
# Nusxa oling: cp .env.example .env

# --------------------------------------------
# Application
# --------------------------------------------
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Cron vazifalari shu zonada ishlaydi (kunlik eslatma, backup)
TZ=Asia/Tashkent

# --------------------------------------------
# Telegram Bot
# --------------------------------------------
BOT_TOKEN=your-telegram-bot-token

# Bo'sh qoldirilsa — polling rejimi (lokal ishlab chiqish uchun).
# To'ldirilsa — webhook rejimi (production uchun tavsiya etiladi).
BOT_WEBHOOK_URL=
BOT_WEBHOOK_PATH=/webhook

# Webhook so'rovlari haqiqiyligini tekshirish uchun.
# Yaratish: openssl rand -hex 32
BOT_SECRET_TOKEN=

# --------------------------------------------
# Telegram Mini App
# --------------------------------------------
# DIQQAT: Telegram Mini App tugmasi FAQAT https:// manzillar uchun
# ko'rsatiladi. HTTP bo'lsa tugma yashiriladi (log'da ogohlantirish chiqadi).
# Bu manzil CORS whitelist'iga ham qo'shiladi.
MINI_APP_URL=http://localhost:5173

# --------------------------------------------
# Database - PostgreSQL
# --------------------------------------------
DATABASE_URL=postgresql://finance:finance123@localhost:5432/finance_manager?schema=public

# docker-compose uchun (majburiy, standart qiymati yo'q)
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance_manager

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --------------------------------------------
# Admin
# --------------------------------------------
# Vergul bilan ajratilgan Telegram ID'lar. Bu ID'lar bilan birinchi
# marta kirgan foydalanuvchi avtomatik ADMIN roli oladi.
ADMIN_TELEGRAM_IDS=123456789

# --------------------------------------------
# JWT
# --------------------------------------------
# Yaratish: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-change-in-production

# --------------------------------------------
# Backup
# --------------------------------------------
# Backup uchun `pg_dump` va `psql` PATH'da bo'lishi shart
# (Docker образида postgresql-client o'rnatilgan).
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --------------------------------------------
# Logging
# --------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
